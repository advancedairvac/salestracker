
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  SALESPERSON
}

enum LeadSource {
  SELF_GENERATED
  COMPANY_GENERATED
}

enum OpportunityStatus {
  OPEN
  PERMANENTLY_CLOSED
  TEMPORARILY_CLOSED
  SCHEDULED_TO_REOPEN
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum FollowUpType {
  CALL
  EMAIL
  TEXT
  MEETING
  OTHER
}

enum FollowUpScheduleType {
  STANDARD
  MANUAL
}

enum ActivityType {
  CALL
  EMAIL
  TEXT
  MEETING
  NOTE
  STATUS_CHANGE
  FOLLOW_UP
  OTHER
}

// ============================================
// ID COUNTER
// ============================================

model IdCounter {
  prefix    String   @id
  nextValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ============================================
// USER
// ============================================

model User {
  id           String  @id @default(cuid())
  displayId    String? @unique
  name         String
  username     String  @unique
  email        String  @unique
  passwordHash String  @db.Text

  // Profile Information
  title String?

  // Sales Goals
  monthlyGoal   Decimal @default(0) @db.Decimal(12, 2)
  quarterlyGoal Decimal @default(0) @db.Decimal(12, 2)
  annualGoal    Decimal @default(0) @db.Decimal(12, 2)

  // Account Information
  role      UserRole @default(SALESPERSON)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Opportunity Relations
  assignedOpportunities Opportunity[] @relation("OpportunityAssignedTo")
  createdOpportunities  Opportunity[] @relation("OpportunityCreatedBy")
  closedOpportunities   Opportunity[] @relation("OpportunityClosedBy")

  // Follow-up Relations
  assignedFollowUps FollowUp[] @relation("FollowUpAssignedTo")

  // Activity Relations
  activities Activity[]

  @@index([role, isActive])
}

// ============================================
// QUICKBOOKS CONNECTION
// ============================================

model QuickBooksConnection {
  id                    String    @id @default(cuid())
  realmId               String
  environment           String    @default("sandbox")
  accessTokenEncrypted  String    @db.Text
  refreshTokenEncrypted String    @db.Text
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([realmId, environment])
  @@index([environment, updatedAt])
}

// ============================================
// CUSTOMER
// ============================================

model Customer {
  id           String  @id @default(cuid())
  displayId    String? @unique

  // External Integration IDs
  stCustomerId String? @unique
  qbCustomerId String? @unique

  // Customer Information
  pocName      String?
  businessName String?
  phone        String?
  email        String?
  location     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  opportunities Opportunity[]

  @@index([businessName])
  @@index([pocName])
  @@index([email])
  @@index([phone])
}

// ============================================
// OPPORTUNITY
// ============================================

model Opportunity {
  id        String  @id @default(cuid())
  displayId String? @unique

  // ServiceTitan Integration
  serviceTitanEstimateId String? @unique

  // Customer Information
  customerId String

  // Opportunity Information
  title           String
  opportunityDate DateTime @default(now())
  jobType         String?
  textMessage     String?  @db.Text

  // Estimated Value
  value Decimal @default(0) @db.Decimal(12, 2)

  // Lead Source
  source LeadSource

  // Opportunity Status
  status OpportunityStatus @default(OPEN)

  // Assignment
  assignedToId String
  createdById  String
  closedById   String?

  // Notes
  notes String? @db.Text

  // Closing and Reopening
  closedAt DateTime?
  reopenAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Customer Relation
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Assigned Salesperson
  assignedTo User @relation("OpportunityAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)

  // Created By
  createdBy User @relation("OpportunityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Closed By
  closedBy User? @relation("OpportunityClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  // Follow-up Relations
  followUpSchedules FollowUpSchedule[]
  followUps         FollowUp[]

  // Activity Relation
  activities Activity[]

  @@index([customerId])
  @@index([assignedToId, status])
  @@index([createdById])
  @@index([closedById])
  @@index([status, opportunityDate])
  @@index([source, opportunityDate])
  @@index([closedAt])
  @@index([reopenAt])
}

// ============================================
// FOLLOW-UP SCHEDULE
// ============================================

model FollowUpSchedule {
  id            String @id @default(cuid())
  opportunityId String

  // STANDARD or MANUAL
  mode FollowUpScheduleType @default(STANDARD)

  // Active Schedule Cycle
  isActive Boolean @default(true)

  // Schedule Information
  presentationAt DateTime
  startedAt      DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  followUps FollowUp[]

  @@index([opportunityId, isActive])
  @@index([mode, isActive])
}

// ============================================
// FOLLOW-UP
// ============================================

model FollowUp {
  id        String  @id @default(cuid())
  displayId String? @unique

  opportunityId String

  // Nullable for existing records during migration
  scheduleId String?

  assignedToId String

  // Nullable for Manual Follow-up without a date
  dueAt DateTime?

  status FollowUpStatus @default(PENDING)

  type FollowUpType?

  // STANDARD or MANUAL
  scheduleType FollowUpScheduleType @default(STANDARD)

  // Standard sequence:
  // 1 = 24 hours
  // 2 = 36 hours
  // 3 = 1 week
  // 4 = 2 weeks
  // 5 = 1 month
  sequence Int?

  // Only active follow-ups can trigger notifications
  isActive Boolean @default(true)

  notes String? @db.Text

  completedAt DateTime?

  // Notification Tracking
  notificationSentAt   DateTime?
  notificationAttempts Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Opportunity Relation
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  // Schedule Cycle Relation
  schedule FollowUpSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  // Assigned Salesperson
  assignedTo User @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)

  @@index([opportunityId, dueAt])
  @@index([scheduleId])
  @@index([assignedToId, status, dueAt])
  @@index([status, dueAt, isActive])
  @@index([scheduleType, sequence])
}

// ============================================
// ACTIVITY
// ============================================

model Activity {
  id            String       @id @default(cuid())
  opportunityId String
  userId        String

  type        ActivityType
  description String       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Opportunity Relation
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  // User Relation
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([opportunityId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}
