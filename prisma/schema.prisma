
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  SALESPERSON
}

enum LeadSource {
  SELF_GENERATED
  COMPANY_GENERATED
}

enum OpportunityStatus {
  OPEN
  PERMANENTLY_CLOSED
  TEMPORARILY_CLOSED
  SCHEDULED_TO_REOPEN
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum FollowUpType {
  CALL
  EMAIL
  TEXT
  MEETING
  OTHER
}

enum FollowUpScheduleType {
  STANDARD
  MANUAL
}

enum ActivityType {
  CALL
  EMAIL
  TEXT
  MEETING
  NOTE
  STATUS_CHANGE
  FOLLOW_UP
  OTHER
}

// ============================================
// USER
// ============================================

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String
  title        String?

  monthlyGoal   Decimal? @db.Decimal(12, 2)
  quarterlyGoal Decimal? @db.Decimal(12, 2)
  annualGoal    Decimal? @db.Decimal(12, 2)

  role     UserRole @default(SALESPERSON)
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Opportunities
  assignedOpportunities Opportunity[] @relation("OpportunityAssignedTo")
  createdOpportunities  Opportunity[] @relation("OpportunityCreatedBy")
  closedOpportunities   Opportunity[] @relation("OpportunityClosedBy")

  // Follow-ups
  assignedFollowUps FollowUp[] @relation("FollowUpAssignedTo")

  // Activities
  activities Activity[]

  // Sales
  assignedSales Sale[] @relation("SaleAssignedTo")

  @@index([role])
  @@index([isActive])
}

// ============================================
// CUSTOMER
// ============================================

model Customer {
  id String @id @default(cuid())

  // ServiceTitan customer reference
  stCustomerId String? @unique

  pocName     String?
  businessName String?
  phone       String?
  email       String?
  location    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities Opportunity[]
  sales         Sale[]

  @@index([businessName])
  @@index([phone])
  @@index([email])
}

// ============================================
// OPPORTUNITY
// ============================================

model Opportunity {
  id String @id @default(cuid())

  serviceTitanEstimateId String? @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  title          String
  opportunityDate DateTime
  jobType        String?
  textMessage    String?
  value          Decimal? @db.Decimal(12, 2)

  source LeadSource @default(COMPANY_GENERATED)
  status OpportunityStatus @default(OPEN)

  assignedToId String?
  assignedTo   User? @relation("OpportunityAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User @relation("OpportunityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  closedById String?
  closedBy   User? @relation("OpportunityClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  notes     String?
  closedAt  DateTime?
  reopenAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  followUpSchedules FollowUpSchedule[]
  followUps         FollowUp[]
  activities        Activity[]

  @@index([customerId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([closedById])
  @@index([status])
  @@index([opportunityDate])
}

// ============================================
// FOLLOW-UP SCHEDULE
// ============================================

model FollowUpSchedule {
  id String @id @default(cuid())

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  mode     FollowUpScheduleType @default(STANDARD)
  isActive Boolean @default(true)

  presentationAt DateTime?
  startedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  followUps FollowUp[]

  @@index([opportunityId])
  @@index([isActive])
}

// ============================================
// FOLLOW-UP
// ============================================

model FollowUp {
  id String @id @default(cuid())

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  scheduleId String?
  schedule   FollowUpSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User? @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  dueAt DateTime?

  status       FollowUpStatus @default(PENDING)
  type         FollowUpType?
  scheduleType FollowUpScheduleType @default(STANDARD)

  sequence Int @default(0)
  isActive Boolean @default(true)

  notes       String?
  completedAt DateTime?

  notificationSentAt  DateTime?
  notificationAttempts Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([opportunityId])
  @@index([scheduleId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueAt])
}

// ============================================
// ACTIVITY
// ============================================

model Activity {
  id String @id @default(cuid())

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  type        ActivityType
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([opportunityId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ============================================
// SALE / REVENUE
// ============================================

model Sale {
  id String @id @default(cuid())

  // ServiceTitan job reference
  serviceTitanJobId     String @unique
  serviceTitanJobNumber String?

  // Customer information
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String?

  // Revenue value from ServiceTitan
  saleValue Decimal @default(0) @db.Decimal(12, 2)

  // Admin-managed fields
  source LeadSource?

  salesmanId String?
  salesman   User? @relation("SaleAssignedTo", fields: [salesmanId], references: [id], onDelete: SetNull)

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([salesmanId])
  @@index([source])
  @@index([completedAt])
}
