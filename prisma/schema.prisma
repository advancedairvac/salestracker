generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  SALESPERSON
}

enum LeadSource {
  SELF_GENERATED
  COMPANY_GENERATED
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ActivityType {
  CALL
  EMAIL
  TEXT
  MEETING
  NOTE
  STATUS_CHANGE
  FOLLOW_UP
  OTHER
}


// ============================================
// USER
// ============================================

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String   @db.Text

  // Profile Information
  title String?

  // Sales Goals
  monthlyGoal   Decimal @default(0) @db.Decimal(12, 2)
  quarterlyGoal Decimal @default(0) @db.Decimal(12, 2)
  annualGoal    Decimal @default(0) @db.Decimal(12, 2)

  // Account Information
  role      UserRole @default(SALESPERSON)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Opportunity Relations
  assignedOpportunities Opportunity[] @relation("OpportunityAssignedTo")
  createdOpportunities  Opportunity[] @relation("OpportunityCreatedBy")
  closedOpportunities   Opportunity[] @relation("OpportunityClosedBy")

  // Follow-up Relations
  assignedFollowUps FollowUp[] @relation("FollowUpAssignedTo")

  // Activity Relations
  activities Activity[]

  // Sales Relations
  closedSales Sale[] @relation("SaleClosedBy")

  @@index([role, isActive])
}


// ============================================
// QUICKBOOKS CONNECTION
// ============================================

model QuickBooksConnection {
  id                    String    @id @default(cuid())
  realmId               String
  environment           String    @default("sandbox")
  accessTokenEncrypted  String    @db.Text
  refreshTokenEncrypted String    @db.Text
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([realmId, environment])
  @@index([environment, updatedAt])
}

// ============================================
// CUSTOMER
// ============================================

model Customer {
  id           String   @id @default(cuid())
  stCustomerId String?  @unique
  qbCustomerId String?  @unique
  pocName      String?
  businessName String
  phone        String?
  email        String?
  location     String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  opportunities Opportunity[]

  @@index([businessName])
  @@index([email])
  @@index([phone])
}

// ============================================
// OPPORTUNITY
// ============================================

model Opportunity {
  id              String            @id @default(cuid())
  title           String
  customerId      String
  opportunityDate DateTime          @default(now())
  jobType         String
  textMessage     String?           @db.Text
  value           Decimal           @default(0) @db.Decimal(12, 2)
  source          LeadSource
  status          OpportunityStatus @default(OPEN)

  assignedToId String
  createdById  String
  closedById   String?

  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  assignedTo User @relation("OpportunityAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)

  createdBy User @relation("OpportunityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  closedBy User? @relation("OpportunityClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  followUps  FollowUp[]
  activities Activity[]
  sales      Sale[]

  @@index([customerId])
  @@index([assignedToId, status])
  @@index([createdById])
  @@index([closedById])
  @@index([status, opportunityDate])
  @@index([source, opportunityDate])
  @@index([closedAt])
}

// ============================================
// FOLLOW-UP
// ============================================

model FollowUp {
  id            String         @id @default(cuid())
  opportunityId String
  assignedToId  String
  dueAt         DateTime
  status        FollowUpStatus @default(PENDING)
  notes         String?        @db.Text
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  assignedTo User @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)

  @@index([opportunityId, dueAt])
  @@index([assignedToId, status, dueAt])
  @@index([status, dueAt])
}

// ============================================
// ACTIVITY
// ============================================

model Activity {
  id            String       @id @default(cuid())
  opportunityId String
  userId        String
  type          ActivityType
  description   String       @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([opportunityId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

// ============================================
// SALE
// ============================================

model Sale {
  id            String     @id @default(cuid())
  opportunityId String
  closedById    String
  saleValue     Decimal    @db.Decimal(12, 2)
  source        LeadSource
  closedAt      DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  serviceTitanJobId String? @unique

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)

  closedBy User @relation("SaleClosedBy", fields: [closedById], references: [id], onDelete: Restrict)

  @@index([opportunityId, closedAt])
  @@index([closedById, closedAt])
  @@index([source, closedAt])
  @@index([closedAt])
}
