generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  SALESPERSON
}

enum LeadSource {
  SELF_GENERATED
  COMPANY
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  SCHEDULED_TO_REOPEN
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum FollowUpType {
  CALL
  EMAIL
  TEXT
  MEETING
  OTHER
}

enum FollowUpScheduleType {
  STANDARD
  MANUAL
}

enum FollowUpEventType {
  H24
  H36
  W1
  W2
  M1
  MANUAL
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum ActivityType {
  CALL
  EMAIL
  TEXT
  MEETING
  NOTE
  STATUS_CHANGE
  FOLLOW_UP
  OTHER
}

// ============================================
// USER
// ============================================

model User {
  id           String  @id @default(cuid())
  name         String
  username     String? @unique
  email        String  @unique
  passwordHash String?
  title        String?

  monthlyGoal   Decimal? @db.Decimal(12, 2)
  quarterlyGoal Decimal? @db.Decimal(12, 2)
  annualGoal    Decimal? @db.Decimal(12, 2)

  role     UserRole @default(SALESPERSON)
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Opportunities
  assignedOpportunities Opportunity[] @relation("OpportunityAssignedTo")
  createdOpportunities  Opportunity[] @relation("OpportunityCreatedBy")
  closedOpportunities   Opportunity[] @relation("OpportunityClosedBy")

  // Follow-ups
  assignedFollowUps FollowUp[] @relation("FollowUpAssignedTo")

  // Email Templates
  emailTemplates EmailTemplate[]

  // Activities
  activities Activity[]

  // Sales Assignments
  assignedSales Sale[] @relation("SaleAssignedTo")

  @@index([role])
  @@index([isActive])
}

// ============================================
// CUSTOMER
// ============================================

model Customer {
  id String @id @default(cuid())

  // Optional ServiceTitan customer reference
  stCustomerId String? @unique

  pocName      String?
  businessName String?
  phone        String?
  email        String?
  location     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities Opportunity[]

  @@index([businessName])
  @@index([phone])
  @@index([email])
}

// ============================================
// OPPORTUNITY
// ============================================

model Opportunity {
  id String @id @default(cuid())

  // Optional ServiceTitan references
  titanEstimateId String? @unique
  titanJobId      String? @unique

  // Customer relationship
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Opportunity details
  opportunityDate DateTime
  jobType         String?
  textMessage     String?
  value           Decimal? @db.Decimal(12, 2)

  // Source and status
  source LeadSource        @default(COMPANY)
  status OpportunityStatus @default(OPEN)

  // Assigned salesperson
  assignedToId String?
  assignedTo   User?   @relation("OpportunityAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Creator
  createdById String
  createdBy   User   @relation("OpportunityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Closing information
  closedById String?
  closedBy   User?   @relation("OpportunityClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  notes    String?
  closedAt DateTime?
  reopenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Related records
  followUpSchedule FollowUpSchedule?
  followUps        FollowUp[]
  activities       Activity[]

  @@index([customerId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([closedById])
  @@index([status])
  @@index([opportunityDate])
}

// ============================================
// FOLLOW-UP SCHEDULE
// One schedule per Opportunity
// Controls STANDARD / MANUAL mode
// ============================================

model FollowUpSchedule {
  id String @id @default(cuid())

  opportunityId String      @unique
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  mode     FollowUpScheduleType @default(STANDARD)
  isActive Boolean              @default(true)

  presentationAt DateTime?
  startedAt      DateTime?
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  followUps        FollowUp[]
  notificationLogs NotificationLog[]

  @@index([isActive, mode])
}

// ============================================
// FOLLOW-UP
// Six independent rows per Opportunity
// H24, H36, W1, W2, M1, MANUAL
// ============================================

model FollowUp {
  id String @id @default(cuid())

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  scheduleId String
  schedule   FollowUpSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Follow-up configuration
  eventType    FollowUpEventType
  scheduleType FollowUpScheduleType @default(STANDARD)
  type         FollowUpType

  // 1 = H24, 2 = H36, 3 = W1,
  // 4 = W2, 5 = M1, 6 = MANUAL
  sequence Int

  // Manual follow-up can initially have no due date
  dueAt DateTime?

  status   FollowUpStatus @default(PENDING)
  isActive Boolean        @default(true)

  // Completion information
  notes       String?
  completedAt DateTime?

  // Independent notification retry tracking
  notificationSentAt    DateTime?
  notificationAttempts  Int       @default(0)
  maxAttempts           Int       @default(3)
  nextRetryAt           DateTime?
  lastNotificationError String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Notification history
  notificationLogs NotificationLog[]

  @@unique([scheduleId, sequence])
  @@index([opportunityId])
  @@index([scheduleId])
  @@index([assignedToId])
  @@index([status])
  @@index([isActive, status, dueAt])
  @@index([isActive, status, nextRetryAt])
  @@index([eventType])
}

// ============================================
// NOTIFICATION LOG
// Individual notification attempt history
// ============================================

model NotificationLog {
  id String @id @default(cuid())

  // Related follow-up
  followUpId String
  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  // Related schedule
  scheduleId String
  schedule   FollowUpSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  // Used email template (null for CALL/TEXT)
  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Idempotency key
  eventKey String @unique

  // Notification event
  eventType     FollowUpEventType
  attemptNumber Int

  // Recipient
  recipientEmail String?

  // Notification status
  status NotificationStatus @default(PENDING)

  // Attempt timing
  scheduledAt DateTime
  sentAt      DateTime?

  // Snapshot of sent email
  subjectSnapshot String?
  bodySnapshot    String? @db.Text

  // Provider information
  providerMessageId String?
  errorMessage      String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([followUpId, attemptNumber])
  @@index([scheduleId])
  @@index([followUpId])
  @@index([status, scheduledAt])
  @@index([eventType])
}

// ============================================
// EMAIL TEMPLATE
// Global defaults and salesperson templates
// ============================================

model EmailTemplate {
  id String @id @default(cuid())

  // Null = Global default
  // User ID = Salesperson custom template
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventType FollowUpEventType

  name    String
  subject String
  body    String @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificationLogs NotificationLog[]

  // One template per user and event type
  @@unique([userId, eventType])
  @@index([eventType])
  @@index([userId])
}

// ============================================
// ACTIVITY
// UNCHANGED
// ============================================

model Activity {
  id String @id @default(cuid())

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  type        ActivityType
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([opportunityId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ============================================
// SALE / REVENUE ASSIGNMENT
// UNCHANGED
// ============================================

model Sale {
  id String @id @default(cuid())

  // ServiceTitan Job reference
  serviceTitanJobId String @unique

  // Admin-managed assignment fields
  salesmanId String?
  salesman   User?   @relation("SaleAssignedTo", fields: [salesmanId], references: [id], onDelete: SetNull)

  source LeadSource?

  // Commission estimate
  commissionEstimate Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesmanId])
  @@index([source])
}
